# Copy this file to .env and enter your Alpaca Paper Trading credentials.
# Never commit .env.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Optional separate paper account credentials. When absent, APCA keys are used
# only against the fixed paper endpoint and verified by a paper account query.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
# Pin the account UUID from Alpaca Paper account settings. Journal reads stay
# local during broker outages; broker operations verify credentials match it.
ALPACA_PAPER_ACCOUNT_ID=
# Web submission stays disabled unless this exact server-side flag is true.
# The browser never receives credentials and cannot select a live endpoint.
ENABLE_PAPER_WEB_ORDERS=false
# Required when the FRED/ALFRED batch collector is enabled.
FRED_API_KEY=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=raw.market.v1
SPARK_CHECKPOINT_ROOT=.spark-checkpoints/market-processor
BAR_SINK=postgres
POSTGRES_DB=market
POSTGRES_USER=market
POSTGRES_PASSWORD=market
POSTGRES_PORT=55432
DATABASE_URL=postgresql://market:market@localhost:55432/market
