# Copy this file to .env and enter your Alpaca Paper Trading credentials.
# Never commit .env.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
FRED_API_KEY=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=raw.market.v1
SPARK_CHECKPOINT_ROOT=.spark-checkpoints/market-processor
BAR_SINK=postgres
POSTGRES_DB=market
POSTGRES_USER=market
POSTGRES_PASSWORD=market
POSTGRES_PORT=55432
DATABASE_URL=postgresql://market:market@localhost:55432/market
